# Copy to .env and adjust. Only the two URLs are required.

# --- Pi-holes (v6, passwordless) --------------------------------------------
# The main Pi-hole is the source of truth; the secondary is synced to mirror it.
# Use each Pi-hole's IP address: a passwordless Pi-hole rejects API requests made
# to any name that isn't its own (IP, pi.hole, its host name or webserver.domain).
PIHOLE_MAIN_URL=http://192.168.1.118
PIHOLE_MAIN_NAME=Pi-hole .118
PIHOLE_SECONDARY_URL=http://192.168.1.33
PIHOLE_SECONDARY_NAME=Pi-hole .33

# DNS checks query each Pi-hole's URL host on port 53. Override with host:port.
# PIHOLE_MAIN_DNS=192.168.1.118:53
# IPv6 DNS check: "auto" finds each Pi-hole's global IPv6 address from its own
# API (so a changed ISP prefix doesn't break it), "off" skips it, or give an address.
# PIHOLE_MAIN_IPV6=auto
# PIHOLE_SECONDARY_IPV6=auto

# --- Alerts (ntfy) ------------------------------------------------------------
NTFY_URL=https://ntfy.example.com
NTFY_TOPIC=pihole
# Only if your ntfy server needs an access token to publish:
NTFY_TOKEN=

# --- Safety -------------------------------------------------------------------
# false = read-only: monitoring, history and the sync preview work, but Apply,
# edits, blocking pauses and gravity runs are refused.
ALLOW_WRITES=false

# --- Auto-sync ----------------------------------------------------------------
# true = apply sync changes by itself after each background check (needs
# ALLOW_WRITES=true). It waits for you instead, with an alert, when a change would
# delete more than AUTO_SYNC_MAX_DELETES items, remove an adlist, or copy an empty
# main Pi-hole.
AUTO_SYNC=false
# AUTO_SYNC_MAX_DELETES=5

# --- Tuning (defaults shown) ------------------------------------------------------
# CHECK_INTERVAL=30         seconds between health checks
# FAIL_THRESHOLD=2          failed checks in a row before an "unreachable"/"DNS failing" alert
# DNS_PROBE_DOMAIN=example.com
# DNS_TIMEOUT_MS=1000       slower answers count as failures
# RECURSION_INTERVAL=300    seconds between lookups of a random, never-cached name (0 = off)
# RECURSION_TIMEOUT_MS=3000 how long those (and the DNSSEC check) may take
# DNSSEC_INTERVAL=3600      seconds between DNSSEC validation checks (0 = off)
# DNSSEC_PROBE_DOMAIN=dnssec-failed.org   a domain whose DNSSEC is broken on purpose
# BLOCKING_GRACE_MIN=10     blocking may be off this long before an alert
# GRAVITY_MAX_DAYS=8        alert when blocklists are older than this
# DRIFT_INTERVAL=900        seconds between sync comparisons
# DRIFT_GRACE_MIN=60        out of sync this long before an alert
# HISTORY_INTERVAL=600      seconds between history imports
# BACKFILL_DAYS=92          history imported from each Pi-hole on first run
# RETENTION_DAYS=730        how long history is kept
# QUERY_LOG_SIZE=500        recent queries fetched from each Pi-hole
# TZ=Europe/London
